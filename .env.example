# =====================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
#  1. Copien este archivo como ".env" (cp .env.example .env)
#  2. Llenen sus valores en .env
#  3. .env NUNCA se sube a GitHub (está en .gitignore). Este archivo sí.
#  Si una variable no está en .env, el proyecto usa un valor seguro por
#  defecto (ver app/config.py), así que puede arrancar incompleto.
# =====================================================================

# ---------- Aplicación ----------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- PostgreSQL (docker-compose usa estas 4 variables) ----------
POSTGRES_USER=chatbot
# cámbienla si quieren; solo es local
POSTGRES_PASSWORD=chatbot_local
POSTGRES_DB=chatbot_uae
POSTGRES_PORT=5432

# URL que usa el backend. Debe coincidir con las 4 variables de arriba.
# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://chatbot:chatbot_local@localhost:5432/chatbot_uae
# false = el chatbot funciona sin registrar consultas (no requiere Docker)
DB_ENABLED=true

# ---------- Modelo de lenguaje (API) ----------
# mock = respuestas de prueba, sin clave y sin costo (para desarrollar)
# openai_compatible = proveedor real; requiere las 3 variables siguientes
#
# Ejemplo con Groq (plan gratuito; ver README, "Conectar Groq"):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.8-27b
#   LLM_API_KEY=<su clave personal de console.groq.com/keys>
# La clave es personal: va solo en su .env, nunca en este archivo ni en GitHub.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
# Margen sobre las ~250 palabras que pide el prompt. Cuenta para el límite de
# tokens por minuto del proveedor.
LLM_MAX_TOKENS=800

# ---------- Embeddings ----------
# local = modelo multilingüe preentrenado (requiere requirements-embeddings.txt).
#         Es el modo real del chatbot.
# mock  = sin modelo, solo para pruebas o para trabajar en la interfaz. Solo
#         compara palabras: no sirve para medir la calidad de las respuestas.
EMBEDDINGS_PROVIDER=local
# Modelo elegido en la calibración (ver README, "Calibración"). Si lo cambian,
# vuelvan a calibrar RAG_MAX_DISTANCE con scripts/calibrar.py.
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- Índice vectorial y RAG ----------
CHROMA_COLLECTION=fichas_uae
INDEX_ON_STARTUP=true
# Fragmentos de búsqueda recuperados por pregunta (son pequeños: se piden varios)
RAG_TOP_K=8
# Calibrado para MiniLM-L12 (ver README). Con EMBEDDINGS_PROVIDER=mock las
# distancias son otras y este valor no aplica.
RAG_MAX_DISTANCE=0.50
# Tamaño máximo de cada fragmento de búsqueda (tokens). Si el modelo de
# embeddings lee menos, se usa el límite del modelo.
RAG_FRAGMENTO_MAX_TOKENS=128
# Párrafos o elementos de lista que se repiten entre partes de una sección
RAG_FRAGMENTO_SOLAPAMIENTO=1
# Tokens (estimados) del contexto que recibe el modelo de lenguaje por
# pregunta. Bájelo si el proveedor limita los tokens por minuto.
RAG_CONTEXTO_MAX_TOKENS=1500
